  width: 466px;
  height: 430px;
  flex-direction: column;
  align-items: center;
}

/* 表盘环已下线，恢复时取消注释
.dial-a {
  background-image: url(internal://cache/techpie-dial-0.png);
  background-size: 466px 466px;
  background-position: center;
  background-repeat: no-repeat;
}


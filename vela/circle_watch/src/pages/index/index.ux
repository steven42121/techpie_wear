<template>
  <!-- 表盘环已下线（代码已注释保留），恢复时把 dialCls 类绑定加回 page -->
  <div class="page">
    <swiper class="swiper" indicator="false" loop="false" index="1" onchange="onPageChange">
      <div class="panel exit-panel" static></div>

      <div class="panel">
        <div class="dial-face">
          <text class="dial-date"><span>{{ dayLabel }}</span><span class="{{ connOk ? 'ct-ok' : 'ct-bad' }}"> · {{ connText }}</span></text>
          <text class="dial-name">{{ focusTitle }}</text>
          <text class="dial-sub">{{ focusSub }}</text>
          <text class="dial-loc">{{ focusLoc }}</text>
          <div class="day-actions">
            <div class="btn day" @click="prevDay">
              <text class="btn-text" static>前一天</text>
            </div>
            <div class="btn day" @click="nextDay">
              <text class="btn-text" static>后一天</text>
            </div>
          </div>
          <div class="sync-btn" @click="syncCurrent">
            <text class="btn-text">{{ syncLabel }}</text>
          </div>
        </div>
      </div>

      <div class="panel qr-panel">
        <div class="qr-box">
          <image class="qr" if="{{ qrPath !== '' }}" src="{{ qrPath }}"></image>
          <text class="qr-hint" if="{{ qrPath === '' && !signing }}">{{ qrHint }}</text>
          <text class="qr-hint" if="{{ signing }}">{{ signLabel }}</text>
        </div>
        <div class="qr-actions">
          <div class="btn wide {{ signing ? 'busy' : '' }}" @click="qrAction">
            <text class="btn-text">{{ signBtnLabel }}</text>
          </div>
        </div>
        <text class="qr-meta">{{ qrMeta }}</text>
      </div>

      <div class="panel assign-panel">
        <scroll class="panel-scroll" scroll-y="true">
          <div class="rows">
            <text class="section-title">{{ assignmentLabel }}</text>
            <div class="empty" if="{{ assignmentCount === 0 }}">
              <text class="et1">{{ assignEmptyTitle }}</text>
              <text class="et2">{{ assignEmptySub }}</text>
            </div>
            <div class="row" for="assignments">
              <text class="rt1">{{ $item.t2 }}</text>
              <text class="rt2">{{ $item.sub }}</text>
            </div>
          </div>
        </scroll>
      </div>
    </swiper>

    <div class="dots">
      <div class="dot-slot">
        <div class="dot-solid" if="{{ page === 1 }}"></div>
        <div class="dot-hollow" if="{{ page !== 1 }}"></div>
      </div>
      <div class="dot-slot">
        <div class="dot-solid" if="{{ page === 2 }}"></div>
        <div class="dot-hollow" if="{{ page !== 2 }}"></div>
      </div>
      <div class="dot-slot">
        <div class="dot-solid" if="{{ page === 3 }}"></div>
        <div class="dot-hollow" if="{{ page !== 3 }}"></div>
      </div>
    </div>
  </div>
</template>

<style>

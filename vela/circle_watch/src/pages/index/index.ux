  width: 18px;
  height: 18px;
  border-radius: 9px;
  border: 2px solid #636366;
}
</style>

<script>
import interconnect from '@system.interconnect'
import file from '@system.file'
import brightness from '@system.brightness'
import storage from '@system.storage'
import router from '@system.router'

// 加密/二维码模块体积大，推迟到首次生成离线码时再加载（启动优化）。
// const ringmod = require('../../common/ring.js')
let cryptoKit = null
function ensureCrypto() {
  if (!cryptoKit) {
    const sm2pkg = require('../../common/sm2.js')
    cryptoKit = {
      sm2: sm2pkg.makeSm2(sm2pkg.CONSTS),
      qr: require('../../common/qr.js'),
      png: require('../../common/png.js')
    }
  }
  return cryptoKit
}

// base64 查表只建一次，避免每张二维码都重建映射。
const B64_MAP = (() => {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
  const map = {}
  for (let i = 0; i < chars.length; i++) {
    map[chars.charAt(i)] = i
  }
  return map
})()

const WEEK_NAMES = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']

const pad2 = (n) => ('0' + n).slice(-2)

// 分片消息类型白名单：新增可分片协议时需同步。不限类型时，对端可用任意
// t 造出无上限的分片缓存（chunkParts[kind]），拖垮手环内存。
const CHUNK_KINDS = {
  'ecard.snap.chunk': 1,
  'offline.cred.chunk': 1,
  'schedule.week.chunk': 1,
  'schedule.snap.chunk': 1,
  'assignments.snap.chunk': 1
}

export default {
  // 仅 UI 绑定的数据放在 private（响应式视图模型）。
  private: {
    connOk: false,
    connText: '未连接',
    page: 1,
    syncLabel: '同步 0.16.0',
    focusTitle: 'TechPie',
    focusSub: '',
    focusLoc: '',
    assignmentCount: 0,
    assignments: [],
    assignmentLabel: '作业',
    assignEmptyTitle: '尚未同步作业',
    assignEmptySub: '连接手机后点同步',
    dayLabel: '今天',
    qrPath: '',
    signing: false,
    signLabel: '',
    signBtnLabel: '生成离线码',
    qrHint: '滑到本页自动获取',
    qrMeta: ''
  },
  onInit() {
    // 非 UI 状态挂在实例普通属性上，不进响应式视图模型（减少 diff 开销）。
    this.conn = null
    this.timers = []
    this.dialTimer = 0
    this.courses = []
    this.courseCount = 0
    this.dayOffset = 0
    this.synced = false
    this.emptyTitle = '尚未同步课表'
    this.emptySub = '手机端 TechPie 在线时自动同步'
    this.weekMap = {}
    this.chunkParts = {}
    this.qrParts = {}
    this.qrSeq = 0
    this.savedBrightness = null
    this.savedMode = null
    this.brightnessToken = 0
    this.logText = '准备就绪'
    this.cred = null
    this.signJob = null
    this.signCount = 0
    this.signMessageHex = ''
    this.signStartedAt = 0
    try {
      this.loadCred()
      this.createConn()
      this.checkState()
      this.requestSchedule(false)
      // TODO(test): 模拟器联调数据注入，真机出包前删除本行及 injectTest 方法
      this.later(() => { this.injectTest() }, 300)
      // 每分钟刷新表盘时间指针/焦点课，仅在课程页时真正重绘。
      this.dialTimer = setInterval(() => {
        if (this.page === 1) {
          this.updateFocus()
          // this.renderDial()
        }
      }, 60000)
    } catch (e) {
      this.log('初始化异常: ' + e)
    }
  },
  createConn() {
    const conn = interconnect.instance()
    this.conn = conn
    conn.onopen = (res) => {
      // 断线期间的分片缓存已无意义，连接重置时清掉。
      this.chunkParts = {}
      this.qrParts = {}
      this.setConnected(true)
      this.log(res.isReconnected ? '已重新连接' : '已连接手机端')
      this.syncCurrent()
    }
    conn.onclose = () => {
      this.chunkParts = {}
      this.qrParts = {}
      this.setConnected(false)
      this.log('连接已断开')
    }
    conn.onerror = (res) => {
      this.setConnected(false)
      this.log('连接出错 code=' + res.code)
    }
    conn.onmessage = (res) => {
      try {
        const text = typeof res.data === 'string' ? res.data : String(res.data)
        if (text.indexOf('"t":"offline.cred"') >= 0) {
          this.log('收到: [离线凭证]')
        } else {
          this.log('收到: ' + text)
        }
        this.handleMessage(res.data)
      } catch (e) {
        this.log('消息处理异常: ' + e)
      }
    }
  },
  onPageChange(e) {
    let index = 1
    if (e && typeof e.index === 'number') {
      index = e.index
    } else if (e && e.detail && typeof e.detail.index === 'number') {
      index = e.detail.index
    }
    if (index === 0) {
      this.exitApp()
      return
    }
    this.enterPage(index)
  },
  exitApp() {
    try {
      router.back()
    } catch (e) {
      this.log('退出失败')
    }
  },
  enterPage(index) {
    this.page = index
    this.scheduleBrightness(index === 2)
    if (index === 2) {
      this.qrEnter()
    } else if (index === 3) {
      this.requestAssignments(false)
    } else if (index === 1) {
      this.updateFocus()
      // this.renderDial()
    }
    // this.syncDialCls()
    this.log('切到第' + index + '页')
  },
  qrEnter() {
    // 预热加密模块：60KB require + comb 点表构建挪到滑页动画后，
    // 首次点「生成离线码」不再额外卡一拍（UI 先行）。
    this.later(() => {
      try {
        ensureCrypto()
      } catch (e) {}
    }, 300)
    if (this.cred) {
      if (this.qrPath === '') {
        this.qrHint = this.credExpired()
          ? '离线授权已过期，请在手机续期'
          : '点按下方按钮生成离线码'
      }
      if (this.qrMeta === '') {
        this.qrMeta = this.credExpiryText()
      }
      return
    }
    this.requestEcard()
  },
  credExpired() {
    const exp = this.cred ? this.cred.expiresAt : 0
    return typeof exp === 'number' && exp < Math.floor(Date.now() / 1000)
  },
  credExpiryText() {
    const exp = this.cred ? this.cred.expiresAt : 0
    if (typeof exp !== 'number' || exp <= 0) {
      return ''
    }
    const d = new Date(exp * 1000)
    return '授权至 ' + d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate())
  },
  collectParts(store, msg, onDone) {
    if (typeof msg.total !== 'number' || typeof msg.seq !== 'number' ||
        msg.total !== Math.floor(msg.total) || msg.seq !== Math.floor(msg.seq) ||
        msg.total < 1 || msg.total > 200 ||
        msg.seq < 0 || msg.seq >= msg.total ||
        typeof msg.data !== 'string' || msg.data.length > 65536) {
      return
    }
    store[msg.seq] = msg.data
    if (Object.keys(store).length < msg.total) {
      return
    }
    const keys = Object.keys(store).sort((a, b) => a - b)
    let joined = ''
    for (let i = 0; i < keys.length; i++) {
      const part = store[keys[i]]
      delete store[keys[i]]
      if (joined.length + part.length > 524288) {
        this.log('分片包过大，已丢弃')
        return
      }
      joined += part
    }
    onDone(joined)
  },
  handleMessage(raw, fromChunk) {
    let msg = null
    try {
      msg = JSON.parse(raw)
    } catch (e) {
      return
    }
    if (!msg) {
      return
    }
    if (msg.t === 'ping') {
      this.conn.send({ data: { t: 'pong', ts: Date.now() } })
      this.log('链路正常')
      return
    }
    if (msg.t === 'pong') {
      this.log('链路正常')
      return
    }
    if (msg.t === 'ecard.snap') {
      this.qrPath = ''
      this.qrHint = msg.error || '暂无消费码'
      if (msg.error) {
        this.log(msg.error)
      }
      return
    }
    if (msg.t === 'ecard.chunk') {
      // 重组出来的载荷是完整消息，不允许再套分片（防递归嵌套炸弹）。
      if (fromChunk) {
        return
      }
      this.collectParts(this.qrParts, msg, (joined) => this.saveQr(joined))
      return
    }
    if (typeof msg.t === 'string' && msg.t.substring(msg.t.length - 6) === '.chunk') {
      if (fromChunk) {
        return
      }
      const kind = msg.t
      if (!CHUNK_KINDS[kind]) {
        return
      }
      if (!this.chunkParts[kind]) {
        this.chunkParts[kind] = {}
      }
      this.collectParts(this.chunkParts[kind], msg, (joined) => this.handleMessage(joined, true))
      return
    }
    if (msg.t === 'offline.cred.clear') {
      this.clearCred()
      return
    }
    if (msg.t === 'offline.cred') {
      if (msg.error) {
        this.qrPath = ''
        this.qrHint = msg.error
        this.signBtnLabel = '同步授权'
        this.log('凭证同步失败: ' + msg.error)
        return
      }
      this.saveCred(msg)
      return
    }
    if (msg.t === 'schedule.week') {
      if (msg.error) {
        this.log('课表同步失败: ' + msg.error)
        return
      }
      this.applyWeek(msg, false)
      return
    }
    if (msg.t === 'schedule.snap') {
      if (msg.error) {
        this.log('课表同步失败: ' + msg.error)
        return
      }
      this.applySchedule(msg, false)
      return
    }
    if (msg.t === 'assignments.snap') {
      if (msg.error) {
        this.log('作业同步失败: ' + msg.error)
        return
      }
      this.applyAssignments(msg, false)
    }
  },
  setConnected(ok) {
    this.connOk = ok
    this.connText = ok ? '已连接' : '未连接'
  },
  checkState() {
    if (!this.conn) {
      return
    }
    this.conn.getReadyState({
      success: (data) => {
        this.setConnected(data.status === 1)
      },
      fail: () => {
        this.setConnected(false)
      }
    })
  },
  scheduleBrightness(boost) {
    this.brightnessToken += 1
    const token = this.brightnessToken
    if (boost) {
      // 等滑页动画结束再调系统亮度，避免与页面切换竞争。
      this.later(() => {
        if (token !== this.brightnessToken || this.page !== 2) {
          return
        }
        this.boostBrightness()
      }, 500)
    } else {
      this.restoreBrightness()
    }
  },
  boostBrightness() {
    if (!brightness) {
      return
    }
    brightness.getMode({
      success: (modeRes) => {
        const mode = modeRes && typeof modeRes.mode === 'number' ? modeRes.mode : 0
        brightness.getValue({
          success: (res) => {
            if (this.savedBrightness === null) {
              this.savedBrightness = res.value
              this.savedMode = mode
            }
            if (this.page !== 2) {
              return
            }
            if (mode === 1) {
              brightness.setMode({ mode: 0 })
              this.later(() => {
                if (this.page === 2) {
                  brightness.setValue({ value: 255 })
                }
              }, 300)
            } else {
              brightness.setValue({ value: 255 })
            }
          },
          fail: () => {}
        })
      },
      fail: () => {}
    })
  },
  restoreBrightness() {
    if (!brightness) {
      return
    }
    if (this.savedBrightness === null) {
      return
    }
    const value = this.savedBrightness
    const mode = this.savedMode
    this.savedBrightness = null
    this.savedMode = null
    brightness.setValue({ value })
    if (mode === 1) {
      this.later(() => {
        brightness.setMode({ mode: 1 })
      }, 300)
    }
  },
  onHide() {
    this.restoreBrightness()
  },
  onDestroy() {
    if (this.dialTimer) {
      clearInterval(this.dialTimer)
      this.dialTimer = 0
    }
    this.restoreBrightness()
    this.clearTimers()
    // 退出时清掉内存中的私钥与签名任务；凭证本身留在 storage，下次启动再载入。
    this.signJob = null
    this.cred = null
    this.maybeGC()
  },
  applySchedule(msg, fromCache) {
    this.courses = this.decorateCourses(msg.courses || [])
    this.courseCount = this.courses.length
    this.synced = true
    this.updateDayLabel()
    this.emptyTitle = this.courseCount === 0 ? '今日无课' : '尚未同步课表'
    this.emptySub = this.courseCount === 0 ? '换一天看看' : '手机端 TechPie 在线时自动同步'
    this.updateFocus()
    // this.renderDial()
    if (fromCache) {
      this.log('使用缓存课表')
    } else {
      this.log('已同步 ' + this.courseCount + ' 节课')
    }
  },
  applyAssignments(msg, fromCache) {
    this.assignments = this.decorateAssignments(msg.items || [])
    this.assignmentCount = this.assignments.length
    this.assignEmptyTitle = '暂无待交作业'
    this.assignEmptySub = '截止前一天提醒'
    this.assignmentLabel = '作业 · ' + this.assignmentCount + '项'
    if (fromCache) {
      this.log('使用缓存作业')
    } else {
      this.saveCache('cache_assignments', msg)
      this.log('已同步 ' + this.assignmentCount + ' 项作业')
    }
  },
  decorateCourses(list) {
    const out = []
    for (let i = 0; i < list.length; i++) {
      const c = list[i]
      const lvl = c.st === 'ongoing' ? 2 : (c.st === 'past' ? 0 : 1)
      out.push({
        n2: c.n + '\n',
        sub: c.s + '-' + c.e + ' · ' + c.loc,
        st: c.st,
        name: c.n,
        s0: c.s,
        e0: c.e,
        loc: c.loc,
        lvl: lvl
      })
    }
    return out
  },
  decorateAssignments(list) {
    const out = []
    for (let i = 0; i < list.length; i++) {
      const a = list[i]
      out.push({
        t2: a.title + '\n',
        sub: a.left + ' · ' + a.course + ' · ' + a.due
      })
    }
    return out
  },
  applyWeek(msg, fromCache) {
    const map = {}
    const days = msg.days || []
    for (let i = 0; i < days.length; i++) {
      map[days[i].date] = this.decorateCourses(days[i].courses || [])
    }
    this.weekMap = map
    this.synced = true
    this.renderDay()
    if (fromCache) {
      this.log('使用缓存课表')
    } else {
      this.saveCache('cache_schedule_week', msg)
      this.log('已同步 ' + days.length + ' 天课表')
    }
  },
  dayDate(offset) {
    const now = new Date()
    return new Date(now.getFullYear(), now.getMonth(), now.getDate() + offset)
  },
  dateKey(offset) {
    const t = this.dayDate(offset)
    return t.getFullYear() + '-' + pad2(t.getMonth() + 1) + '-' + pad2(t.getDate())
  },
  renderDay() {
    const list = this.weekMap[this.dateKey(this.dayOffset)] || []
    this.courses = list
    this.courseCount = list.length
    if (this.synced && this.courseCount === 0) {
      this.emptyTitle = this.dayOffset === 0 ? '今日无课' : '当日无课'
      this.emptySub = '换一天看看'
    } else {
      this.emptyTitle = '尚未同步课表'
      this.emptySub = '手机端 TechPie 在线时自动同步'
    }
    this.updateDayLabel()
    this.updateFocus()
    // this.renderDial()
  },
  loadFresh(key, maxAge, cb) {
    if (!storage) {
      cb(null)
      return
    }
    storage.get({
      key,
      success: (data) => {
        try {
          const obj = JSON.parse(data)
          if (obj && typeof obj.at === 'number' &&
              Date.now() - obj.at < maxAge && obj.msg) {
            cb(obj.msg)
          } else {
            cb(null)
          }
        } catch (e) {
          cb(null)
        }
      },
      fail: () => {
        cb(null)
      }
    })
  },
  saveCache(key, msg) {
    if (!storage) {
      return
    }
    try {
      storage.set({
        key,
        value: JSON.stringify({ at: Date.now(), msg: msg })
      })
    } catch (e) {}
  },
  syncCurrent() {
    if (this.page === 2) {
      this.requestEcard()
    } else if (this.page === 3) {
      this.requestAssignments(true)
    } else {
      this.requestSchedule(true)
    }
  },
  requestSchedule(force) {
    if (!this.conn) {
      return
    }
    const date = this.dateKey(this.dayOffset)
    const send = () => {
      this.conn.send({
        data: { t: 'schedule.req', date, week: true },
        success: () => {
          this.log('正在同步课表…')
        },
        fail: (data, code) => {
          this.setConnected(false)
          this.log('同步请求失败 code=' + code)
        }
      })
    }
    if (force) {
      send()
      return
    }
    // 整周快照缓存 7 天；离线翻天直接读缓存。
    this.loadFresh('cache_schedule_week', 604800000, (cached) => {
      if (cached && cached.days) {
        this.applyWeek(cached, true)
      } else {
        send()
      }
    })
  },
  requestAssignments(force) {
    if (!this.conn) {
      return
    }
    const send = () => {
      this.conn.send({
        data: { t: 'assignments.req' },
        success: () => {
          this.log('正在同步作业…')
        },
        fail: (data, code) => {
          this.setConnected(false)
          this.log('作业请求失败 code=' + code)
        }
      })
    }
    if (force) {
      send()
      return
    }
    this.loadFresh('cache_assignments', 86400000, (cached) => {
      if (cached) {
        this.applyAssignments(cached, true)
      } else {
        send()
      }
    })
  },
  requestEcard() {
    if (!this.conn) {
      return
    }
    this.qrParts = {}
    this.conn.send({
      data: { t: 'ecard.req' },
      success: () => {
        this.log('正在获取消费码…')
      },
      fail: (data, code) => {
        this.setConnected(false)
        this.log('消费码请求失败 code=' + code)
      }
    })
  },
  saveQr(base64) {
    // 手环内存有限：异常超长的消费码数据直接拒掉，避免撑爆解码缓冲。
    if (typeof base64 !== 'string' || base64.length > 131072) {
      this.qrHint = '消费码数据异常'
      this.log('消费码数据异常')
      return
    }
    try {
      const bytes = this.decodeBase64(base64)
      this.writeQrFile(bytes, (uri) => {
        this.qrPath = uri
        this.log('消费码已更新')
      }, (code) => {
        this.qrHint = '写入二维码失败 ' + code
        this.log(this.qrHint)
      })
    } catch (e) {
      this.qrHint = '二维码解码失败'
      this.log(this.qrHint)
    }
  },
  writeQrFile(bytes, onDone, onFail) {
    this.qrSeq = (this.qrSeq + 1) % 2
    const uri = 'internal://cache/techpie-qr-' + this.qrSeq + '.png'
    file.writeArrayBuffer({
      uri,
      buffer: bytes,
      success: () => {
        onDone(uri)
        this.maybeGC()
      },
      fail: (data, code) => onFail(code)
    })
  },
  decodeBase64(input) {
    const map = B64_MAP
    const cleaned = input.replace(/[^A-Za-z0-9+/]/g, '')
    const length = cleaned.length
    const out = new Uint8Array(Math.floor(length * 3 / 4))
    let offset = 0
    for (let i = 0; i < length; i += 4) {
      const a = map[cleaned.charAt(i)] || 0
      const b = map[cleaned.charAt(i + 1)] || 0
      const c = map[cleaned.charAt(i + 2)] || 0
      const d = map[cleaned.charAt(i + 3)] || 0
      out[offset++] = (a << 2) | (b >> 4)
      if (i + 2 < length) {
        out[offset++] = ((b & 15) << 4) | (c >> 2)
      }
      if (i + 3 < length) {
        out[offset++] = ((c & 3) << 6) | d
      }
    }
    return out.subarray(0, offset)
  },
  prevDay() {
    this.dayOffset -= 1
    this.renderDay()
    if (!this.synced) {
      this.requestSchedule(false)
    }
  },
  nextDay() {
    this.dayOffset += 1
    this.renderDay()
    if (!this.synced) {
      this.requestSchedule(false)
    }
  },
  updateDayLabel() {
    let base = WEEK_NAMES[this.dayDate(this.dayOffset).getDay()]
    if (this.dayOffset === 0) {
      base = '今天'
    } else if (this.dayOffset === 1) {
      base = '明天'
    } else if (this.dayOffset === -1) {
      base = '昨天'
    }
    this.dayLabel = base + ' · ' + this.courseCount + '节'
  },
  // 凭证字段校验：只收 hex 且限长，挡住异常/伪造载荷撑爆内存与签名缓冲。
  validCred(obj) {
    const hex = (s, max) => typeof s === 'string' && s.length > 0 &&
      s.length <= max && /^[0-9a-fA-F]+$/.test(s)
    return !!obj && hex(obj.privateKey, 128) && hex(obj.pubX, 128) &&
      hex(obj.pubY, 128) && hex(obj.authorInfo, 4096) &&
      typeof obj.expiresAt === 'number'
  },
  loadCred() {
    if (!storage) {
      return
    }
    storage.get({
      key: 'offline_cred',
      success: (data) => {
        try {
          const obj = typeof data === 'string' ? JSON.parse(data) : data
          if (this.validCred(obj)) {
            this.cred = obj
            this.signBtnLabel = '生成离线码'
            if (this.qrPath === '') {
              this.qrHint = '点按下方按钮生成离线码'
            }
          }
        } catch (e) {}
      },
      fail: () => {}
    })
  },
  clearCred() {
    this.cred = null
    this.signJob = null
    this.signing = false
    if (storage) {
      try {
        storage.delete({ key: 'offline_cred' })
      } catch (e) {}
    }
    this.qrPath = ''
    this.qrHint = '未授权，请在手机端开启同步离线支付凭证'
    this.signBtnLabel = '同步授权'
    this.qrMeta = ''
    this.log('离线凭证已清除')
  },
  saveCred(msg) {
    if (!this.validCred(msg)) {
      this.qrHint = '凭证数据无效，请重新同步'
      this.signBtnLabel = '同步授权'
      this.log('凭证数据无效，已拒收')
      return
    }
    this.cred = msg
    this.signBtnLabel = '生成离线码'
    this.qrHint = '点按下方按钮生成离线码'
    this.qrMeta = this.credExpiryText()
    if (storage) {
      try {
        storage.set({ key: 'offline_cred', value: JSON.stringify(msg) })
      } catch (e) {}
    }
    this.log('离线凭证已同步')
  },
  requestOfflineCred() {
    if (!this.conn) {
      return
    }
    this.qrHint = '正在同步离线凭证…'
    this.conn.send({
      data: { t: 'offline.cred.req' },
      success: () => {
        this.log('正在同步离线凭证…')
      },
      fail: (data, code) => {
        this.setConnected(false)
        this.qrHint = '凭证请求失败 code=' + code
        this.log('凭证请求失败 code=' + code)
      }
    })
  },
  qrAction() {
    if (this.signing) {
      return
    }
    if (!this.cred) {
      this.requestOfflineCred()
      return
    }
    this.signLocal()
  },
  signLocal() {
    const cred = this.cred
    if (!cred || this.signing) {
      return
    }
    const nowSec = Math.floor(Date.now() / 1000)
    if (this.credExpired()) {
      this.qrHint = '离线授权已过期，请在手机续期'
      this.qrMeta = this.credExpiryText()
      this.log('离线授权已过期')
      return
    }
    let messageHex
    let job
    try {
      messageHex = String(cred.authorInfo).toUpperCase() +
        this.timeCrcHex(cred.checksum, nowSec)
      job = ensureCrypto().sm2.makeSignJob({
        privateKeyHex: cred.privateKey,
        publicKeyXHex: cred.pubX,
        publicKeyYHex: cred.pubY,
        message: this.hexToBytes(messageHex)
      })
    } catch (e) {
      this.qrHint = '凭证数据无效，请重新同步'
      this.log('签名准备失败: ' + e)
      return
    }
    this.signing = true
    this.signJob = job
    this.signCount = 0
    this.signMessageHex = messageHex
    this.signStartedAt = Date.now()
    this.signBtnLabel = '签名中…'
    this.signLabel = '本地签名中…'
    this.qrPath = ''
    this.qrHint = ''
    this.qrMeta = ''
    this.log('开始本地签名')
    this.signStep()
  },
  signStep() {
    const job = this.signJob
    if (!job) {
      return
    }
    // 时间预算内连续求值：真机 9s 里绝大部分是每步一次 setTimeout + 进度重绘的开销
    //（QuickJS 标定全管线计算仅 ~46ms）。预算 40ms 让单次同步块有上界，
    // 又能在 1~2 个滴答内跑完 31 步。
    const deadline = Date.now() + 40
    let finished = false
    try {
      do {
        finished = job.step()
        this.signCount += 1
      } while (!finished && Date.now() < deadline)
    } catch (e) {
      this.signJob = null
      this.finishSignError('签名失败: ' + e)
      return
    }
    this.signLabel = '本地签名中 ' + this.signCount + '步'
    if (!finished) {
      this.later(() => {
        this.signStep()
      }, 0)
      return
    }
    const sig = job.result()
    this.signJob = null
    if (!sig) {
      this.finishSignError('签名失败，请重试')
      return
    }
    // 收尾工作分到独立滴答执行，避免长同步块冻结手环。
    this.signLabel = '正在生成二维码…'
    this.later(() => {
      this.buildQrImage(sig)
    }, 0)
  },
  buildQrImage(sig) {
    let png
    try {
      const payload = this.hexToBytes(this.signMessageHex + sig)
      const qr = ensureCrypto().qr.encodeQr(payload)
      png = ensureCrypto().png.qrToPngAt(qr, 240)
    } catch (e) {
      this.log('二维码生成失败: ' + e)
      this.finishSignError('二维码失败: ' + e)
      return
    }
    this.writeQrBytes(png)
  },
  writeQrBytes(bytes) {
    this.writeQrFile(bytes, (uri) => {
      // 签名期间收到凭证清除指令：丢弃这次结果，保持未授权状态。
      if (!this.cred) {
        return
      }
      this.qrPath = uri
      this.signing = false
      this.signBtnLabel = '重新生成'
      this.qrHint = ''
      const secs = Math.round((Date.now() - this.signStartedAt) / 1000)
      const now = new Date()
      this.qrMeta = '生成于 ' + pad2(now.getHours()) + ':' + pad2(now.getMinutes()) + ' · 耗时' + secs + 's'
      this.log('离线码已生成 耗时' + secs + 's')
    }, (code) => {
      this.finishSignError('写入二维码失败 ' + code)
    })
  },
  finishSignError(msg) {
    this.signing = false
    this.signBtnLabel = '重试'
    this.signLabel = ''
    this.qrHint = msg
    this.qrMeta = ''
    this.log(msg)
  },
  timeCrcHex(checksum, seconds) {
    const b = [
      (seconds >>> 24) & 0xff,
      (seconds >>> 16) & 0xff,
      (seconds >>> 8) & 0xff,
      seconds & 0xff
    ]
    let x = (checksum || 0) & 0xff
    for (let i = 0; i < 4; i++) {
      x = x ^ b[i]
    }
    return this.bytesToHex(b.concat([x])).toUpperCase()
  },
  hexToBytes(hex) {
    const out = []
    for (let i = 0; i < hex.length; i += 2) {
      out.push(parseInt(hex.substring(i, i + 2), 16))
    }
    return out
  },
  bytesToHex(bytes) {
    let s = ''
    for (let i = 0; i < bytes.length; i++) {
      s += ('0' + (bytes[i] & 0xff).toString(16)).slice(-2)
    }
    return s
  },
//   syncDialCls() {
//     // 表盘背景只在课程页显示，且双缓冲切换触发重绘
//     this.dialCls = this.page === 1 ? (this.dialFlip ? 'dial-b' : 'dial-a') : ''
//   },
  // TODO(test): 模拟器联调数据，走真实 handleMessage 渲染管线，真机出包前整体删除
  injectTest() {
    const now = new Date()
    const fmt = (d) => d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2)
    const mk = (d) => {
      const t = new Date(now.getFullYear(), now.getMonth(), now.getDate() + d)
      return fmt(t)
    }
    const hm = (h, m) => h * 60 + m
    const cur = now.getHours() * 60 + now.getMinutes()
    const st = (s, e) => cur >= s && cur < e ? 'ongoing' : (cur >= e ? 'past' : 'future')
    const C = (n, s, e, loc) => ({ n: n, s: s, e: e, loc: loc, st: st(hm(parseInt(s, 10), parseInt(s.substring(3), 10)), hm(parseInt(e, 10), parseInt(e.substring(3), 10))) })
    const week = {
      t: 'schedule.week',
      days: [
        { date: mk(-1), courses: [C('高等数学', '08:00', '09:40', '教三-305'), C('大学英语', '10:00', '11:40', '外语楼-201')] },
        { date: mk(0), courses: [
          C('高等数学', '08:00', '09:40', '教三-305'),
          C('大学英语', '10:00', '11:40', '外语楼-201'),
          C('数据结构', '14:00', '15:40', '教五-412'),
          C('操作系统', '16:00', '17:40', '教五-408'),
          C('体育（篮球）', '19:00', '20:40', '西区体育馆')
        ] },
        { date: mk(1), courses: [
          C('计算机网络', '08:00', '09:40', '教四-201'),
          C('编译原理', '10:00', '11:40', '教四-203'),
          C('实验课', '14:00', '16:40', '实验楼B-105')
        ] }
      ]
    }
    const assign = {
      t: 'assignments.snap',
      items: [
        { title: '高等数学第三章习题', left: '明天截止', course: '高等数学', due: '23:59' },
        { title: '操作系统实验报告', left: '还剩2天', course: '操作系统', due: '周五 18:00' },
        { title: '英语作文 My Campus', left: '还剩3天', course: '大学英语', due: '周六 12:00' }
      ]
    }
    const cred = {
      t: 'offline.cred',
      privateKey: '3945208f7b2144b13f0e8f9e6b126f2d3f67345371e00718c50f4a18f6d1d16b',
      pubX: '09f9df311e5421a150dd7d11d3e2d2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2',
      pubY: '1c7c4b2e2c0b3f6f9a8f7b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e',
      authorInfo: 'A1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F90',
      checksum: 90,
      expiresAt: Math.floor(Date.now() / 1000) + 2592000
    }
    this.handleMessage(JSON.stringify(week))
    this.handleMessage(JSON.stringify(assign))
    this.handleMessage(JSON.stringify(cred))
    this.log('已注入联调数据')
  },
  log(msg) {
    // 运行时日志走内存字段，避免 console 输出拖慢热路径（启动优化）。
    this.logText = msg
  },
  later(fn, ms) {
    const id = setTimeout(() => {
      const i = this.timers.indexOf(id)
      if (i >= 0) {
        this.timers.splice(i, 1)
      }
      fn()
    }, ms)
    this.timers.push(id)
  },
  clearTimers() {
    const list = this.timers || []
    this.timers = []
    for (let i = 0; i < list.length; i++) {
      try {
        clearTimeout(list[i])
      } catch (e) {}
    }
  },
  maybeGC() {
    try {
      if (typeof global !== 'undefined' && global.runGC) {
        global.runGC()
      }
    } catch (e) {}
  },
//   hueOf(name) {
//     // 课名哈希 -> 固定色相；同一门课跨天永远同色
//     let x = 7
//     const s = String(name || '')
//     for (let i = 0; i < s.length; i++) {
//       x = (x * 31 + s.charCodeAt(i)) & 0xffff
//     }
//     return (x % 360) / 360
//   },
  hhmmToFrac(hhmm) {
    const s = String(hhmm || '')
    const colon = s.indexOf(':')
    if (colon <= 0) {
      return -1
    }
    const h = parseInt(s.substring(0, colon), 10)
    const m = parseInt(s.substring(colon + 1), 10)
    if (isNaN(h) || isNaN(m)) {
      return -1
    }
    return (h * 60 + m) / 1440
  },

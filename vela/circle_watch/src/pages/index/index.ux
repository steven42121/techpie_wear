//         this.dialFlip = this.dialSeq === 1
//         // this.syncDialCls()
//       },
//       fail: () => {}
//     })
//   },
  updateFocus() {
    // 中心大字：优先进行中，其次下一节，最后上一节/占位。
    const list = this.courses || []
    const now = new Date()
    const nowF = (now.getHours() * 60 + now.getMinutes()) / 1440
    let focus = null
    let focusLvl = -1
    for (let i = 0; i < list.length; i++) {
      const f0 = this.hhmmToFrac(list[i].s0)
      const f1 = this.hhmmToFrac(list[i].e0)
      if (f0 < 0) {
        continue
      }
      if (nowF >= f0 && nowF < f1) {
        focus = list[i]
        focusLvl = 2
        break
      }
      if (nowF < f0 && focusLvl < 1) {
        focus = list[i]
        focusLvl = 1
      }
      if (nowF >= f1 && focusLvl < 0) {
        focus = list[i]
        focusLvl = 0
      }
    }
    if (!focus) {
      this.focusTitle = this.courseCount === 0 ? this.emptyTitle : '今天'
      this.focusSub = this.courseCount === 0 ? this.emptySub : ''
      this.focusLoc = ''
      return
    }
    const names = ['刚结束', '下一节', '进行中']
    this.focusTitle = focus.name
    this.focusSub = names[focusLvl] + ' ' + focus.s0 + '-' + focus.e0
    this.focusLoc = focus.loc
  }
}
</script>
